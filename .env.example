# Sales CRM API - environment variables (names only; never commit real values)
# Copy to .env and fill in. The API refuses to start when a required value is missing.

NODE_ENV=development
PORT=4100
APP_NAME=Sales CRM
# Base URL of the UI, used in email links (https in production)
UI_BASE_URL=http://localhost:4200
# Comma-separated browser origins allowed to call the API directly (CORS)
CORS_ORIGINS=http://localhost:4200
# Number of reverse-proxy hops in front of the API (0 when none)
TRUST_PROXY=0

# MySQL: the existing schema unigr8ways_sales_crm and your existing account (the one used in DBeaver).
# The CRM scripts create no database, account or grant (D-22).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unigr8ways_sales_crm
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_SSL=false

# Access-token signing keys (npm run generate:jwt-secret). Never reuse Orchestrator secrets.
CRM_ACCESS_TOKEN_SECRET_CURRENT=
CRM_ACCESS_TOKEN_SECRET_CURRENT_KID=
CRM_ACCESS_TOKEN_SECRET_PREVIOUS=
CRM_ACCESS_TOKEN_SECRET_PREVIOUS_KID=
CRM_JWT_ISSUER=sales-crm-api
CRM_JWT_AUDIENCE=sales-crm-ui
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=480
REFRESH_COOKIE_NAME=crm_refresh
REFRESH_COOKIE_SECURE=true
# Optional server-side pepper for password hashes (keep it stable once set)
PASSWORD_PEPPER=
USER_CONTEXT_CACHE_SECONDS=60

# Email: file (development, writes to MAIL_FILE_DIR) or smtp (required in production, OD-17)
MAIL_TRANSPORT=file
MAIL_FILE_DIR=var/mail
MAIL_FROM=Sales CRM <no-reply@cnergee.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info
LOG_DIR=logs
# Swagger UI at /api-docs (must be false in production, OD-23)
SWAGGER_ENABLED=true

RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_FORGOT_PER_HOUR_EMAIL=3
RATE_LIMIT_FORGOT_PER_HOUR_IP=10
RATE_LIMIT_TOKEN_PER_15MIN=10

# Uploaded documents: a backed-up disk folder outside the web root (OD-18)
FILE_DIR=var/files

# Background jobs (weekly status tasks, Monday report, stale, slip): true on exactly one API instance (8.10)
SCHEDULER_ENABLED=false
